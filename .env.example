RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Immutable constructor argument. Deliberately NOT the deployer: section 3.4
# keeps protocol funds separate from everything else.
PROTOCOL_FEE_RECIPIENT=0x0000000000000000000000000000000000000000

# Damage cap from section 3.3, decided 2026-08-31: 100 ETH.
MAX_POOL_ETH_WEI=100000000000000000000

POOL_MANAGER=0x8366a39CC670B4001A1121B8F6A443A643e40951
CREATE2_DEPLOYER=0x4e59b44847b379578588920cA78FbF26c0B4956C

# No deployer key here, by design. The signer is passed on the command line:
#   cast wallet import deployer --interactive     (once, encrypted keystore)
#   forge script script/Deploy.s.sol --account deployer --broadcast
# A hardware wallet works too: --ledger --sender <address>
