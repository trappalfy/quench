{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "cross-env NEXT_DIST_DIR=.next-build next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "gen:abi": "node scripts/gen-abi.mjs",
    "verify:reads": "tsx scripts/verify-reads.mts",
    "typecheck": "tsc --noEmit",
    "shots": "cross-env MSYS_NO_PATHCONV=1 tsx scripts/shoot.mts",
    "test": "vitest run",
    "e2e": "cross-env MSYS_NO_PATHCONV=1 tsx scripts/e2e-trade.mts"
  },
  "dependencies": {
    "next": "15.5.24",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "viem": "^2.56.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.24",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
